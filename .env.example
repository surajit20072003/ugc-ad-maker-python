# =============================================================================
# UGC Ad Maker — environment template
# =============================================================================
# Copy to .env and fill in:   cp .env.example .env
# Never commit .env. Uncommented = you must set it. Commented (#) = optional; the value shown is the code default.
# =============================================================================

# ── OpenRouter (REQUIRED) ─────────────────────────────────────────────────────
# Used for: Claude (analysis, script, prompts), image generation and some video models.
# Create a key at https://openrouter.ai/keys . Every ad spends credits on this key.
OPENROUTER_API_KEY=

# Image model for ad visuals (any OpenRouter image model), e.g.
#   google/gemini-3-pro-image   (default)   |   black-forest-labs/flux-1.1-pro   |   openai/gpt-image-1
# UGC_IMAGE_MODEL=google/gemini-3-pro-image
# GPT_IMAGE_QUALITY=medium

# ── Voiceover: VoxCPM server (the voxcpm-api service) ─────────────────────────
# URL of your voxcpm-api server (default port 7861) and its X-API-Key (VOXCPM_API_KEY in voxcpm-api/.env)
VOXCPM_URL=http://localhost:7861
VOXCPM_API_KEY=

# ── Local GPU server: image + video generation (the wan2gp-api service) ───────
# URL of your wan2gp-api server (default port 9090) and its X-API-Key (WAN2GP_API_KEY in wan2gp-api/.env)
LOCAL_GPU_URL=http://localhost:9090
LOCAL_GPU_API_KEY=

# ── WaveSpeed (OPTIONAL: only for WaveSpeed lip-sync video) ───────────────────
WAVESPEED_API_KEY=

# ── Public URLs of THIS app ───────────────────────────────────────────────────
# Audio/image/video files are handed to external services by URL, so they must be able to reach this
# server: put its public address here (http://<public-ip>:8765, or your https domain).
SERVER_URL=http://localhost:8765
# Optional https address for services that refuse plain http
# PUBLIC_HTTPS_URL=
# AVATAR_RESOLUTION=1080p
# AVATAR_EXPRESSIVENESS=low

# ── Dynamic Scenes engine (story shots): all optional ─────────────────────────
# SCENE_SHOTS=6            # shots per ad (~$0.30 each at 768p)
# SCENE_MAX_COST=6         # hard cap per ad in USD (stops retries)
# SCENE_CONCURRENCY=3      # parallel shot generations
# SCENE_RESOLUTION=768p
# SCENE_LANGUAGE=          # Hinglish | Hindi | English | any language name
# SCENE_VOICE_ID=          # HeyGen voice id

# ── Infographic B-roll: all optional ──────────────────────────────────────────
# INFOGRAPHIC_BROLL=1
# INFOGRAPHIC_IMAGE_MODEL=openai/gpt-image-2
# INFOGRAPHIC_VIDEO_MODEL=bytedance/seedance-1-5-pro
# INFOGRAPHIC_VIDEO_RESOLUTION=720p
