# ─── OpenRouter (REQUIRED) ────────────────────────────────────────────────────
# Used for: Claude (analysis, script, prompts) + image generation + video
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── OpenRouter Image Model ───────────────────────────────────────────────────
# Options:
#   black-forest-labs/flux-1.1-pro       ← best quality (default)
#   black-forest-labs/flux-schnell       ← fastest
#   google/gemini-2.0-flash-exp:image    ← Google
#   openai/gpt-image-1                   ← GPT image
UGC_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# ─── WaveSpeed (OPTIONAL — only if using WaveSpeed lip-sync video) ────────────
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# ─── VoxCPM TTS (pre-configured) ─────────────────────────────────────────────
VOXCPM_URL=http://204.12.237.78:7861
VOXCPM_API_KEY=spassword

# ─── Server public URL (for serving audio/image files to WaveSpeed) ──────────
# This is YOUR server's IP:port — no CDN needed
SERVER_URL=http://204.12.237.78:8765
